# ==========================================
# FIRE-EYE Backend Environment Variables
# ==========================================

# Database
# For SQLite (Local standalone / lightweight dev):
# DATABASE_URL=sqlite:///./sql_app.db
# For PostgreSQL with PostGIS (Production / Docker):
DATABASE_URL=postgresql+psycopg2://fireuser:firepassword@127.0.0.1:5433/firedb

# Redis (Optional locally; recommended for multi-instance WebSocket pub/sub and distributed deduplication)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SECRET_KEY=generate_a_secure_random_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Supabase Auth Integration (for production & real demo validation)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<project-jwt-signing-secret>
CORS_ALLOW_ORIGINS=*
SEED_DEMO_DATA=false

# Mesh Gateway & Offline Transport
MESH_GATEWAY_NODE_ID=GATEWAY-CENTRAL-01
DEFAULT_TTL=8

# ML Prediction Service (Deterministic path to pre-trained Joblib model)
ML_MODEL_PATH=../ml/models/landslide_model.joblib

# Routing & Navigation (OpenRouteService)
ORS_API_KEY=your_openrouteservice_api_key_here

# Fast API Settings
ENVIRONMENT=development
PROJECT_NAME="FIRE-EYE Disaster Response Engine"

# Optional Emergency Alert Webhooks / Notification Providers
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FCM_SERVER_KEY=

# Groq AI SOS Response Assistant
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

